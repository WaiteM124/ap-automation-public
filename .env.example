# Copy to .env and fill in. Everything except the embedding / vector-store settings is optional.

# Embeddings + vector store (not needed for `pytest` or `scripts/evaluate_poc.py`)
OPENAI_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=invoice_corpus

# LLM gate (stricter-only escalation)
ANTHROPIC_API_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Set to false to send nothing to Langfuse / Supabase
TELEMETRY_ENABLED=true

# Posting
ERP_DB_PATH=data/erp_ledger.db
AUDIT_DB_PATH=data/audit_trail.db
ERP_URL=
GOOGLE_SHEETS_CREDENTIALS=credentials/google_service_account.json
GOOGLE_SHEET_ID=

# SAP posting (see docs/SAP_POSTING.md). OFF by default: nothing is sent to SAP unless BOTH
# ERP_BACKEND=sap and SAP_POSTING_ENABLED=true. Sandbox only: other hosts are refused unless SAP_ALLOW_NON_SANDBOX=true.
# NB: the SAP API Business Hub sandbox is read-only (GET). Writes need your own S/4HANA Cloud tenant.
ERP_BACKEND=simulated
SAP_POSTING_ENABLED=false
SAP_ALLOW_NON_SANDBOX=false
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=
SAP_USERNAME=
SAP_PASSWORD=
SAP_COMPANY_CODE=1110
SAP_DEFAULT_CURRENCY=GBP
SAP_DEFAULT_TAX_CODE=V0
SAP_DEFAULT_SUPPLIER=
# JSON objects, e.g. SAP_SUPPLIER_MAP={"VND-ACME":"11300001"}
SAP_COMPANY_CODE_MAP=
SAP_SUPPLIER_MAP=
SAP_GL_MAP=
SAP_COST_CENTRE_MAP=
SAP_TAX_CODE_MAP=
SAP_TAX_CALCULATED_AUTOMATICALLY=true
SAP_TIMEOUT_SECONDS=20
SAP_MAX_RETRIES=2

# Xero posting (see docs/XERO_POSTING.md). OFF by default: nothing is sent to Xero unless BOTH
# ERP_BACKEND=xero and XERO_POSTING_ENABLED=true, and the app has been connected once with scripts/xero_authorize.py.
# Put the real client id / secret in .env only (never commit them). Tokens are stored in data/xero_tokens.json (git-ignored).
XERO_POSTING_ENABLED=false
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional: discovered from GET /connections when empty
XERO_TENANT_ID=
# Must be registered on your Xero app exactly as written
XERO_REDIRECT_URI=http://localhost:8765/callback
XERO_SCOPES=offline_access accounting.invoices accounting.contacts accounting.settings.read
# DRAFT (default, safest) | SUBMITTED | AUTHORISED
XERO_BILL_STATUS=DRAFT
# Our amount is the invoice total: Inclusive | Exclusive | NoTax
XERO_LINE_AMOUNT_TYPES=Inclusive
XERO_DUE_DAYS=30
# JSON objects, e.g. XERO_ACCOUNT_MAP={"6300":"412"}  XERO_TAX_TYPE_MAP={"STANDARD":"INPUT2","ZERO":"ZERORATEDINPUT"}
XERO_ACCOUNT_MAP=
XERO_TAX_TYPE_MAP=
# Demo Company only: tax type for a VAT treatment with no mapping
XERO_DEFAULT_TAX_TYPE=NONE
# Optional: map our cost centre to a Xero tracking category (name) and option names
XERO_TRACKING_CATEGORY=
XERO_COST_CENTRE_MAP=
XERO_TOKEN_PATH=data/xero_tokens.json
XERO_CHART_ACCOUNT_TYPES=EXPENSE,DIRECTCOSTS,OVERHEADS
XERO_TIMEOUT_SECONDS=20
XERO_MAX_RETRIES=2

# API hardening: when API_KEY is set, mutating endpoints require an X-API-Key header
API_KEY=
# Comma-separated browser origins. Do not use * in shared/deployed environments (AGENTS.md).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Gate thresholds
MIN_EVIDENCE_LINES=3
MIN_MDM_CONFIDENCE=0.85
MIN_AGREEMENT_RATIO=0.80
DEFAULT_CONFIDENCE_THRESHOLD=0.50
